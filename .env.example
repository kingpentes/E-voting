APP_NAME="E-Voting System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.railway.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=evoting
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@evoting.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Blockchain (GoQuorum) ---
# HTTP JSON-RPC endpoint for the penyelenggara node
# Local: http://127.0.0.1:18545
# VPS: http://<VPS_IP>:8545
BLOCKCHAIN_RPC=http://127.0.0.1:18545

# Unlocked account on the node used to send transactions
BLOCKCHAIN_FROM=0xed9d02e382b34818e88b88a309c7fe71e65f419d
# Optional gas settings
BLOCKCHAIN_GAS=0x7a1200

# Path to the ABI JSON for the Evote contract
# Local: /app/storage/contract/evote_abi.json (if using Docker) or full path
# VPS: /var/www/smart-voting/storage/contract/evote_abi.json (example)
CONTRACT_ABI_PATH=/app/storage/contract/evote_abi.json
CONTRACT_ADDRESS=

# Path to the directory containing getAllVotes.js
# Local: /path/to/blockchain/evote-deploy
# VPS: /var/www/quorum-network/evote/evote-deploy (example)
CONTRACT_DEPLOY_PATH=/path/to/blockchain/evote-deploy

# AES-256 key for encrypting votes before storing on-chain (generate with: php artisan key:generate)
VOTE_ENC_KEY=

# --- Google OAuth for Social Login ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-domain.railway.app/auth/google/callback

# --- Gmail API for OTP (Password Reset) ---
GOOGLE_APPLICATION_CREDENTIALS=/app/storage/credentials/google_credentials.json
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="E-Voting System"
